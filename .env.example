# Copia a .env y genera una clave: python -c "from django.core.management.utils import get_random_secret_key;print(get_random_secret_key())"
DJANGO_SECRET_KEY=REEMPLAZA_POR_UNA_CLAVE_ALEATORIA_UNICA
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# En producción: DJANGO_DEBUG=False, DJANGO_ALLOWED_HOSTS=tu-dominio.com y HTTPS.
DJANGO_SSL_REDIRECT=False
